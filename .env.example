# ==============================================================================
# Environment Variables Example for Earthquake Alert SOAP Service
# ==============================================================================
# Copy this template to .env (ignored by git) or set these variables in your
# shell or IDE run configuration. NEVER commit live secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Azure Communication Services (Email Alerts)
# ------------------------------------------------------------------------------
# Retrieve from Azure Portal: Communication Services resource > Settings > Keys
# Or via Azure CLI:
# az communication list-key --name <comm-service> --resource-group <rg> --query primaryConnectionString -o tsv
ACS_CONNECTION_STRING=endpoint=https://<your-communication-service>.unitedstates.communication.azure.com/;accesskey=<your-access-key>

# Azure-assigned sender address from your verified Azure Managed Domain (format: DoNotReply@<guid>.azurecomm.net)
# Retrieve via Azure CLI:
# az communication email domain show --email-service-name <email-service> --domain-name AzureManagedDomain --resource-group <rg> --query fromSenderDomain -o tsv
ACS_SENDER_ADDRESS=DoNotReply@<your-managed-domain>.azurecomm.net

# ------------------------------------------------------------------------------
# Database Persistence (PostgreSQL Flexible Server / Local)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=earthquakedb
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=prefer

# ------------------------------------------------------------------------------
# Scheduled Alert Worker Tuning
# ------------------------------------------------------------------------------
# Alert polling interval in milliseconds (default: 5 minutes / 300000 ms)
ALERT_POLLING_INTERVAL_MS=300000
# Initial delay before first poll in milliseconds (default: 10 seconds / 10000 ms)
ALERT_POLLING_INITIAL_DELAY_MS=10000
